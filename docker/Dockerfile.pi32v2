# Patched pi32v2-gcc toolchain for JieLi AC7911B8 (NOR-flash XIP target).
# The compiler itself is proprietary/patched; this image provides the
# environment and expects the toolchain tarball mounted at build time.
# Usage:
#   docker build -f docker/Dockerfile.pi32v2 -t fm1-pi32v2 docker/
#   docker run --rm -v $(pwd):/work -w /work fm1-pi32v2 make target
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    make file binutils ca-certificates python3 \
 && rm -rf /var/lib/apt/lists/*

# Toolchain provenance (verified 2026-09-03):
#   Official JieLi Linux toolchain, pkgman short link:
#     https://pkgman.jieliapp.com/s/linux-toolchain
#   which currently resolves to jieli-linux-toolchains-20250805.1.tar.xz
#   (extracted tree reports version 20250324.1). Driver for this target:
#     <tree>/pi32v2/bin/cc  ->  clang -target pi32v2  (python3 wrapper)
#   The tarball is intentionally NOT committed (26 MB, gitignored under
#   build/). Fetch it and mount at run time, e.g.:
#     ./docker/run-target.sh build/toolchain/<tree>/pi32v2/bin
#   or bake it in: COPY <tree>/ /opt/jieli/  (then CC_PI=/opt/jieli/pi32v2/bin/cc)
# Drop the patched pi32v2-gcc tree here when available, e.g.:
# COPY pi32v2-toolchain/ /opt/pi32v2/
# Alternatively mount it at container run time (see run-target.sh):
#   docker run -v /path/to/toolchain/bin:/opt/pi32v2-toolchain:ro ...
ENV PATH="/opt/pi32v2-toolchain:/opt/pi32v2/bin:${PATH}"

WORKDIR /work
CMD ["make", "target", "CC_PI=pi32v2-gcc"]
